{
  "package": "@smashcut/player",
  "subpaths": {
    ".": {
      "source": "./dist/smashcut-player.js",
      "runtime": {
        "script": "./dist/smashcut-player.global.js",
        "import": "./dist/smashcut-player.js",
        "require": "./dist/smashcut-player.cjs"
      },
      "types": "./dist/smashcut-player.d.ts",
      "environments": ["browser"]
    },
    "./slideshow": {
      "source": "./dist/slideshow/smashcut-slideshow.js",
      "runtime": {
        "script": "./dist/slideshow/smashcut-slideshow.global.js",
        "import": "./dist/slideshow/smashcut-slideshow.js",
        "require": "./dist/slideshow/smashcut-slideshow.cjs"
      },
      "types": "./dist/slideshow/smashcut-slideshow.d.ts",
      "environments": ["browser"]
    }
  }
}
