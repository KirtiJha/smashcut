{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Chromatic Aberration Wipe - Demo</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      #demo {\n        width: 1920px;\n        height: 1080px;\n        display: grid;\n        place-items: center;\n        background: #f7f7f8;\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .demo-frame {\n        display: grid;\n        place-items: center;\n        padding: 52px;\n        /* ponytail: scale wrapper (not a GSAP target) to fill ~65% of 1920x1080 */\n        transform: scale(1.85);\n      }\n      .sc-catalog-chromatic-aberration-wipe {\n        --sc-accent: #2563eb;\n        --sc-ink: #111827;\n        --sc-muted: #6b7280;\n        --sc-surface: #ffffff;\n        color: var(--sc-ink);\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .sc-catalog-chromatic-aberration-wipe {\n        position: relative;\n        width: 760px;\n        height: 428px;\n        overflow: hidden;\n        border-radius: 30px;\n        background: #111827;\n        box-shadow: 0 28px 80px rgba(15, 23, 42, 0.2);\n      }\n      .sc-catalog-chromatic-aberration-wipe .scene {\n        position: absolute;\n        inset: 0;\n        display: grid;\n        place-items: center;\n        font-weight: 900;\n        font-size: 58px;\n        letter-spacing: -0.05em;\n        color: #fff;\n      }\n      .sc-catalog-chromatic-aberration-wipe .from {\n        background: linear-gradient(135deg, #111827, #374151);\n        transform: translate(var(--sc-from-x, 0px), var(--sc-from-y, 0px))\n          scale(var(--sc-from-scale, 1));\n        filter: blur(var(--sc-from-blur, 0px));\n      }\n      .sc-catalog-chromatic-aberration-wipe .to {\n        background: linear-gradient(135deg, #2563eb, #7c3aed);\n        transform: translate(var(--sc-to-x, 0px), var(--sc-to-y, 0px)) scale(var(--sc-to-scale, 1));\n        clip-path: inset(\n          var(--sc-clip-top, 0%) var(--sc-clip-right, 100%) var(--sc-clip-bottom, 0%)\n            var(--sc-clip-left, 0%)\n        );\n      }\n      .sc-catalog-chromatic-aberration-wipe .fx {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.75), transparent);\n        mix-blend-mode: screen;\n        transform: translateX(var(--sc-fx-x, -110%));\n      }\n      .sc-catalog-chromatic-aberration-wipe .rgb {\n        position: absolute;\n        inset: 0;\n        pointer-events: none;\n        opacity: var(--sc-rgb-opacity, 0);\n        background: linear-gradient(\n          90deg,\n          rgba(239, 68, 68, 0.35),\n          transparent,\n          rgba(34, 211, 238, 0.35)\n        );\n        transform: translateX(var(--sc-rgb-x, 0px));\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"demo\"\n      data-composition-id=\"chromatic-aberration-wipe-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"5\"\n    >\n      <div class=\"demo-frame\">\n        <div class=\"sc-catalog-chromatic-aberration-wipe\" data-composition-variables='[\n    { \"id\": \"direction\", \"type\": \"enum\", \"role\": \"motion\", \"label\": \"Direction\", \"description\": \"The direction the reveal travels; both scenes slide the same way and the wipe edge follows.\", \"default\": \"left\", \"options\": [{ \"value\": \"left\", \"label\": \"Left\" }, { \"value\": \"right\", \"label\": \"Right\" }, { \"value\": \"up\", \"label\": \"Up\" }, { \"value\": \"down\", \"label\": \"Down\" }] },\n    { \"id\": \"accent\", \"type\": \"enum\", \"role\": \"style\", \"label\": \"Accent\", \"description\": \"Colour family of the incoming scene&#39;s gradient.\", \"default\": \"blue\", \"options\": [{ \"value\": \"blue\", \"label\": \"Blue\" }, { \"value\": \"green\", \"label\": \"Green\" }, { \"value\": \"violet\", \"label\": \"Violet\" }] },\n    { \"id\": \"aberration\", \"type\": \"number\", \"role\": \"style\", \"label\": \"Aberration\", \"description\": \"Multiplies the red/cyan channel split: 0 removes it, 1 is the stock strength, 2 doubles the offset and saturates the flash.\", \"default\": 1, \"min\": 0, \"max\": 2, \"step\": 0.1, \"unit\": \"x\" }\n  ]'>\n          <div class=\"scene from\">Before</div>\n          <div class=\"scene to\">Chromatic Aberration Wipe</div>\n          <div class=\"fx\"></div>\n          <div class=\"rgb\"></div>\n        </div>\n      </div>\n      <script>\n  (function () {\n    \"use strict\";\n\n    var vars =\n      window.__smashcut && window.__smashcut.getVariables\n        ? window.__smashcut.getVariables()\n        : {};\n\n    // Unrecognised overrides return to their declared defaults.\n    var directions = {\n      left: { ax: \"1\", ay: \"0\", t: \"0\", r: \"1\", b: \"0\", l: \"0\" },\n      right: { ax: \"-1\", ay: \"0\", t: \"0\", r: \"0\", b: \"0\", l: \"1\" },\n      up: { ax: \"0\", ay: \"1\", t: \"1\", r: \"0\", b: \"0\", l: \"0\" },\n      down: { ax: \"0\", ay: \"-1\", t: \"0\", r: \"0\", b: \"1\", l: \"0\" },\n    };\n    var accents = {\n      blue: [\"#2563eb\", \"#7c3aed\"],\n      green: [\"#047857\", \"#34d399\"],\n      violet: [\"#6d28d9\", \"#a78bfa\"],\n    };\n\n    function pick(table, value, fallback) {\n      return Object.prototype.hasOwnProperty.call(table, value) ? value : fallback;\n    }\n\n    var direction = directions[pick(directions, vars.direction, \"left\")];\n    var accent = accents[pick(accents, vars.accent, \"blue\")];\n\n    var raw = typeof vars.aberration === \"string\" ? parseFloat(vars.aberration) : vars.aberration;\n    var aberration = typeof raw === \"number\" && isFinite(raw) ? Math.min(2, Math.max(0, raw)) : 1;\n\n    var roots = document.querySelectorAll(\".sc-catalog-chromatic-aberration-wipe\");\n    for (var i = 0; i < roots.length; i += 1) {\n      roots[i].style.setProperty(\"--sc-wipe-ax\", direction.ax);\n      roots[i].style.setProperty(\"--sc-wipe-ay\", direction.ay);\n      roots[i].style.setProperty(\"--sc-wipe-t\", direction.t);\n      roots[i].style.setProperty(\"--sc-wipe-r\", direction.r);\n      roots[i].style.setProperty(\"--sc-wipe-b\", direction.b);\n      roots[i].style.setProperty(\"--sc-wipe-l\", direction.l);\n      roots[i].style.setProperty(\"--sc-scene-a\", accent[0]);\n      roots[i].style.setProperty(\"--sc-scene-b\", accent[1]);\n      roots[i].style.setProperty(\"--sc-rgb-strength\", String(aberration));\n    }\n  })();\n</script>\n<script>\n        const tl = gsap.timeline({ paused: true });\n        const startTime = 0.5;\n        tl.fromTo(\n          \".sc-catalog-chromatic-aberration-wipe .to\",\n          { \"--sc-clip-right\": \"100%\", \"--sc-to-x\": \"60px\", \"--sc-to-scale\": 1.04 },\n          {\n            \"--sc-clip-right\": \"0%\",\n            \"--sc-to-x\": \"0px\",\n            \"--sc-to-scale\": 1,\n            duration: 0.9,\n            ease: \"power3.inOut\",\n          },\n          startTime,\n        );\n        tl.to(\n          \".sc-catalog-chromatic-aberration-wipe .from\",\n          {\n            \"--sc-from-x\": \"-70px\",\n            \"--sc-from-scale\": 0.96,\n            \"--sc-from-blur\": \"5px\",\n            duration: 0.9,\n            ease: \"power3.inOut\",\n          },\n          startTime,\n        );\n        tl.fromTo(\n          \".sc-catalog-chromatic-aberration-wipe .fx\",\n          { \"--sc-fx-x\": \"-110%\" },\n          { \"--sc-fx-x\": \"110%\", duration: 0.58, ease: \"power2.inOut\" },\n          startTime + 0.18,\n        );\n        tl.fromTo(\n          \".sc-catalog-chromatic-aberration-wipe .rgb\",\n          { \"--sc-rgb-opacity\": 0, \"--sc-rgb-x\": \"-16px\" },\n          {\n            \"--sc-rgb-opacity\": 1,\n            \"--sc-rgb-x\": \"16px\",\n            repeat: 3,\n            yoyo: true,\n            duration: 0.07,\n            ease: \"steps(1)\",\n          },\n          startTime + 0.32,\n        );\n        tl.set({}, {}, 5);\n        window.__timelines = window.__timelines || {};\n        window.__timelines[\"chromatic-aberration-wipe-demo\"] = tl;\n      </script>\n    </div>\n  <style>\n  .sc-catalog-chromatic-aberration-wipe {\n    --sc-accent: #2563eb;\n    --sc-ink: #111827;\n    --sc-muted: #6b7280;\n    --sc-surface: #ffffff;\n    color: var(--sc-ink);\n    font-family: Inter, system-ui, sans-serif;\n  }\n  .sc-catalog-chromatic-aberration-wipe {\n    position: relative;\n    width: 760px;\n    height: 428px;\n    overflow: hidden;\n    border-radius: 30px;\n    background: #111827;\n    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.2);\n  }\n  .sc-catalog-chromatic-aberration-wipe .scene {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    font-weight: 900;\n    font-size: 58px;\n    letter-spacing: -0.05em;\n    color: #fff;\n  }\n  .sc-catalog-chromatic-aberration-wipe .from {\n    background: linear-gradient(135deg, #111827, #374151);\n    transform: translate(\n        calc(var(--sc-from-x, 0px) * var(--sc-wipe-ax, 1)),\n        calc(var(--sc-from-y, 0px) + var(--sc-from-x, 0px) * var(--sc-wipe-ay, 0))\n      )\n      scale(var(--sc-from-scale, 1));\n    filter: blur(var(--sc-from-blur, 0px));\n  }\n  .sc-catalog-chromatic-aberration-wipe .to {\n    background: linear-gradient(135deg, var(--sc-scene-a, #2563eb), var(--sc-scene-b, #7c3aed));\n    transform: translate(\n        calc(var(--sc-to-x, 0px) * var(--sc-wipe-ax, 1)),\n        calc(var(--sc-to-y, 0px) + var(--sc-to-x, 0px) * var(--sc-wipe-ay, 0))\n      )\n      scale(var(--sc-to-scale, 1));\n    clip-path: inset(\n      calc(var(--sc-clip-top, 0%) + var(--sc-clip-right, 100%) * var(--sc-wipe-t, 0))\n        calc(var(--sc-clip-right, 100%) * var(--sc-wipe-r, 1))\n        calc(var(--sc-clip-bottom, 0%) + var(--sc-clip-right, 100%) * var(--sc-wipe-b, 0))\n        calc(var(--sc-clip-left, 0%) + var(--sc-clip-right, 100%) * var(--sc-wipe-l, 0))\n    );\n  }\n  .sc-catalog-chromatic-aberration-wipe .fx {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.75), transparent);\n    mix-blend-mode: screen;\n    transform: translateX(var(--sc-fx-x, -110%));\n  }\n  .sc-catalog-chromatic-aberration-wipe .rgb {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: calc(var(--sc-rgb-opacity, 0) * var(--sc-rgb-strength, 1));\n    background: linear-gradient(\n      90deg,\n      rgba(239, 68, 68, 0.35),\n      transparent,\n      rgba(34, 211, 238, 0.35)\n    );\n    transform: translateX(calc(var(--sc-rgb-x, 0px) * var(--sc-rgb-strength, 1)));\n  }\n</style>\n</body>\n</html>\n"}