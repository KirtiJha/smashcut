-2: var(--sc-ui-space-2, 8px);\n    --_hf-ui-space-3: var(--sc-ui-space-3, 12px);\n    --_hf-ui-space-4: var(--sc-ui-space-4, 16px);\n    --_hf-ui-space-6: var(--sc-ui-space-6, 24px);\n    --_hf-ui-space-8: var(--sc-ui-space-8, 32px);\n    --_hf-ui-surface: var(--sc-ui-surface, #141414);\n    --_hf-ui-surface-inset: var(--sc-ui-surface-inset, #101010);\n    --_hf-ui-surface-raised: var(--sc-ui-surface-raised, #1a1a1a);\n    --_hf-ui-text: var(--sc-ui-text, #e5e5e5);\n    --_hf-ui-text-faint: var(--sc-ui-text-faint, #7e7e7e);\n    --_hf-ui-text-muted: var(--sc-ui-text-muted, #929292);\n    --_hf-ui-text-strong: var(--sc-ui-text-strong, #f3f3f3);\n    --_hf-ui-warning: var(--sc-ui-warning, #e9ab55);\n    --_hf-ui-weight-medium: var(--sc-ui-weight-medium, 500);\n    --_hf-ui-weight-regular: var(--sc-ui-weight-regular, 400);\n    --_hf-ui-weight-semibold: var(--sc-ui-weight-semibold, 600);\n    box-sizing: border-box;\n    color-scheme: dark;\n    font-family: var(--_hf-ui-font-sans);\n  }\n  /* prettier-ignore */\n  [data-sc-ui-root] *,\n  [data-sc-ui-root] *::before,\n  [data-sc-ui-root] *::after {\n    box-sizing: border-box;\n  }\n  /* prettier-ignore */\n  [data-sc-theme=\"light\"] [data-sc-ui-root],\n  [data-sc-ui-root][data-sc-theme=\"light\"] {\n    --_hf-ui-accent: var(--sc-ui-accent, #087a57);\n    --_hf-ui-action: var(--sc-ui-action, #171717);\n    --_hf-ui-action-contrast: var(--sc-ui-action-contrast, #ffffff);\n    --_hf-ui-border: var(--sc-ui-border, #e0dfdb);\n    --_hf-ui-border-strong: var(--sc-ui-border-strong, #cbc9c3);\n    --_hf-ui-canvas: var(--sc-ui-canvas, #f6f5f1);\n    --_hf-ui-control-border: var(--sc-ui-control-border, #888888);\n    --_hf-ui-control-border-hover: var(--sc-ui-control-border-hover, #6f6e68);\n    --_hf-ui-danger: var(--sc-ui-danger, #a61b1b);\n    --_hf-ui-data-1: var(--sc-ui-data-1, #087a57);\n    --_hf-ui-data-2: var(--sc-ui-data-2, #245ea8);\n    --_hf-ui-data-3: var(--sc-ui-data-3, #8a4b00);\n    --_hf-ui-data-4: var(--sc-ui-data-4, #6d3fc0);\n    --_hf-ui-data-5: var(--sc-ui-data-5, #a83d2d);\n    --_hf-ui-shadow-contact: var(--sc-ui-shadow-contact, 0 7px 16px rgba(26, 24, 20, 0.13));\n    --_hf-ui-shadow-inset: var(--sc-ui-shadow-inset, inset 0 1px 0 rgba(255, 255, 255, 0.78));\n    --_hf-ui-shadow-modal: var(--sc-ui-shadow-modal, 0 18px 46px rgba(26, 24, 20, 0.18));\n    --_hf-ui-surface: var(--sc-ui-surface, #ffffff);\n    --_hf-ui-surface-inset: var(--sc-ui-surface-inset, #f0efeb);\n    --_hf-ui-surface-raised: var(--sc-ui-surface-raised, #ffffff);\n    --_hf-ui-text: var(--sc-ui-text, #171717);\n    --_hf-ui-text-faint: var(--sc-ui-text-faint, #6f6e68);\n    --_hf-ui-text-muted: var(--sc-ui-text-muted, #5f5f5a);\n    --_hf-ui-text-strong: var(--sc-ui-text-strong, #0a0a0a);\n    --_hf-ui-warning: var(--sc-ui-warning, #8a4b00);\n    color-scheme: light;\n  }\n  /* prettier-ignore */\n  [data-sc-ui-root]:focus-visible {\n    outline: 2px solid var(--_hf-ui-accent);\n    outline-offset: 3px;\n  }\n  /* prettier-ignore */\n  [data-sc-rendering=\"true\"][data-sc-ui-root],\n  [data-sc-rendering=\"true\"] [data-sc-ui-root],\n  [data-sc-rendering=\"true\"][data-sc-ui-root] *,\n  [data-sc-rendering=\"true\"] [data-sc-ui-root] *,\n  [data-sc-rendering=\"true\"][data-sc-ui-root]::before,\n  [data-sc-rendering=\"true\"][data-sc-ui-root]::after,\n  [data-sc-rendering=\"true\"] [data-sc-ui-root]::before,\n  [data-sc-rendering=\"true\"] [data-sc-ui-root]::after,\n  [data-sc-rendering=\"true\"][data-sc-ui-root] *::before,\n  [data-sc-rendering=\"true\"][data-sc-ui-root] *::after,\n  [data-sc-rendering=\"true\"] [data-sc-ui-root] *::before,\n  [data-sc-rendering=\"true\"] [data-sc-ui-root] *::after {\n    animation-duration: 0s !important;\n    animation-delay: 0s !important;\n    transition-duration: 0s !important;\n    transition-delay: 0s !important;\n  }\n  /* prettier-ignore */\n  @media (prefers-reduced-motion: reduce) {\n    [data-sc-ui-root],\n    [data-sc-ui-root] *,\n    [data-sc-ui-root] *::before,\n    [data-sc-ui-root] *::after {\n      animation-duration: 0s !important;\n      animation-delay: 0s !important;\n      transition-duration: 0s !important;\n      transition-delay: 0s !important;\n      scroll-behavior: auto !important;\n    }\n  }\n  /* sc-ui:tokens:end */\n  .sc-ui-blur-in {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.28em;\n    color: var(--_hf-ui-text-strong);\n    font: var(--_hf-ui-weight-semibold) 52px/1 var(--_hf-ui-font-sans);\n    letter-spacing: -0.02em;\n  }\n  .sc-ui-blur-in span {\n    display: inline-block;\n    filter: blur(0px);\n    opacity: 1;\n    will-change: opacity, transform, filter;\n  }\n</style>\n\n<!--\n  Timeline integration:\n  tl.fromTo('.sc-ui-blur-in span', { opacity: 0, y: 8, filter: 'blur(10px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.36, stagger: 0.04, ease: 'power3.out' }, startTime);\n-->\n<!-- sc-ui:canonical:end -->\n      </section>\n      <p class=\"sc-ui-demo-caption\">Blur In</p>\n      <script>\n  (function () {\n    \"use strict\";\n\n    var vars =\n      window.__smashcut && window.__smashcut.getVariables\n        ? window.__smashcut.getVariables()\n        : {};\n\n    // Unrecognised overrides return to their declared defaults.\n    function pick(table, value, fallback) {\n      return Object.prototype.hasOwnProperty.call(table, value) ? value : fallback;\n    }\n\n    function clampNumber(value, min, max, fallback) {\n      var n = typeof value === \"number\" ? value : parseFloat(value);\n      if (!isFinite(n)) {\n        return fallback;\n      }\n      return Math.min(max, Math.max(min, n));\n    }\n\n    var tones = {\n      strong: \"var(--_hf-ui-text-strong)\",\n      muted: \"var(--_hf-ui-text-muted)\",\n      accent: \"var(--_hf-ui-accent)\",\n    };\n    var aligns = { left: \"flex-start\", center: \"center\", right: \"flex-end\" };\n\n    var size = clampNumber(vars.size, 24, 120, 52);\n    var tone = tones[pick(tones, vars.tone, \"strong\")];\n    var align = aligns[pick(aligns, vars.align, \"left\")];\n\n    var roots = document.querySelectorAll(\".sc-ui-blur-in\");\n    for (var i = 0; i < roots.length; i += 1) {\n      roots[i].style.setProperty(\"--sc-blur-in-size\", size + \"px\");\n      roots[i].style.setProperty(\"--sc-blur-in-color\", tone);\n      roots[i].style.setProperty(\"--sc-blur-in-align\", align);\n    }\n  })();\n</script>\n<script>\n        const tl = gsap.timeline({ paused: true });\n        tl.addLabel(\"start\", 0);\n        tl.set(\".sc-ui-demo-stage\", { opacity: 1 }, 0);\n        tl.fromTo(\n          \".sc-ui-blur-in span\",\n          { opacity: 0, y: 8, filter: \"blur(10px)\" },\n          {\n            opacity: 1,\n            y: 0,\n            filter: \"blur(0px)\",\n            duration: 0.36,\n            stagger: 0.04,\n            ease: \"power3.out\",\n          },\n          0.3,\n        );\n        tl.addLabel(\"end\", 4);\n        tl.set(\".sc-ui-demo-stage\", { opacity: 1 }, \"end\");\n        window.__timelines = window.__timelines || {};\n        window.__timelines[\"blur-in-demo\"] = tl;\n      </script>\n    </main>\n  <style>\n  /* sc-ui:tokens:start */\n  /* prettier-ignore */\n  [data-sc-ui-root] {\n    --_hf-ui-accent: var(--sc-ui-accent, #3ce6ac);\n    --_hf-ui-action: var(--sc-ui-action, #eeeeee);\n    --_hf-ui-action-contrast: var(--sc-ui-action-contrast, #111111);\n    --_hf-ui-border: var(--sc-ui-border, #2a2a2a);\n    --_hf-ui-border-strong: var(--sc-ui-border-strong, #383838);\n    --_hf-ui-canvas: var(--sc-ui-canvas, #0a0a0a);\n    --_hf-ui-control-border: var(--sc-ui-control-border, #686868);\n    --_hf-ui-control-border-hover: var(--sc-ui-control-border-hover, #777777);\n    --_hf-ui-control-height: var(--sc-ui-control-height, 40px);\n    --_hf-ui-danger: var(--sc-ui-danger, #ff7878);\n    --_hf-ui-data-1: var(--sc-ui-data-1, #3ce6ac);\n    --_hf-ui-data-2: var(--sc-ui-data-2, #63a5ff);\n    --_hf-ui-data-3: var(--sc-ui-data-3, #e9ab55);\n    --_h