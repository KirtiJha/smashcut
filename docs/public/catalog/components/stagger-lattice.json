{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Stagger Lattice - Demo</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js\"></script>\n    <style>\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      #demo {\n        width: 1920px;\n        height: 1080px;\n        display: grid;\n        place-items: center;\n        background: #f4f4f5;\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .sc-advanced-stagger-lattice {\n        --sc-accent: var(--accent, rgba(17, 24, 39, 0.72));\n        --sc-l1: rgba(17, 24, 39, 0.72);\n        --sc-l3: rgba(17, 24, 39, 0.18);\n        --sc-l4: rgba(17, 24, 39, 0.08);\n        --sc-hair: rgba(17, 24, 39, 0.14);\n        color: var(--sc-l1);\n        font-family: Inter, system-ui, sans-serif;\n      }\n      .sc-advanced-stagger-lattice {\n        width: 720px;\n        min-height: 420px;\n        border-radius: 30px;\n        padding: 36px;\n        background: #fff;\n        box-shadow: 0 28px 80px rgba(15, 23, 42, 0.16);\n        display: grid;\n        place-items: center;\n        /* ponytail: zoom scales the wrapper without touching GSAP transform targets (.cell) */\n        zoom: 1.7;\n      }\n      .sc-advanced-stagger-lattice .grid {\n        display: grid;\n        grid-template-columns: repeat(8, 46px);\n        gap: 10px;\n      }\n      .sc-advanced-stagger-lattice .cell {\n        width: 46px;\n        height: 46px;\n        border-radius: 14px;\n        background: var(--sc-l1);\n        transform: translateY(var(--sc-cell-y, 0px)) scale(var(--sc-cell-scale, 1));\n        opacity: var(--sc-cell-opacity, 1);\n      }\n      .sc-advanced-stagger-lattice svg {\n        width: 520px;\n        height: 220px;\n        overflow: visible;\n      }\n      .sc-advanced-stagger-lattice path {\n        fill: none;\n        stroke: var(--sc-accent);\n        stroke-width: 14;\n        stroke-linecap: round;\n        stroke-dasharray: 900;\n        stroke-dashoffset: var(--sc-dash, 0);\n      }\n      .sc-advanced-stagger-lattice .stack {\n        position: relative;\n        width: 520px;\n        height: 260px;\n      }\n      .sc-advanced-stagger-lattice .card {\n        position: absolute;\n        inset: 0;\n        border-radius: 26px;\n        background: linear-gradient(var(--sc-l4), var(--sc-l4)), #ffffff;\n        border: 1px solid var(--sc-hair);\n        box-shadow: 0 20px 54px rgba(15, 23, 42, 0.14);\n        transform: translateY(var(--sc-card-y, 0px)) scale(var(--sc-card-scale, 1));\n        opacity: var(--sc-card-opacity, 1);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"demo\"\n      data-composition-id=\"stagger-lattice-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"5\"\n    >\n      <div class=\"sc-advanced-stagger-lattice\">\n        <div class=\"grid\">\n          <span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span><span class=\"cell\"></span><span class=\"cell\"></span\n          ><span class=\"cell\"></span>\n        </div>\n      </div>\n    </div>\n    <script>\n      const tl = gsap.timeline({ paused: true });\n      const startTime = 0.5;\n      tl.fromTo(\n        \".sc-advanced-stagger-lattice .cell\",\n        { \"--sc-cell-y\": \"24px\", \"--sc-cell-scale\": 0.72, \"--sc-cell-opacity\": 0 },\n        {\n          \"--sc-cell-y\": \"0px\",\n          \"--sc-cell-scale\": 1,\n          \"--sc-cell-opacity\": 1,\n          duration: 0.28,\n          stagger: { each: 0.018, from: \"center\", grid: [5, 8] },\n          ease: \"power2.out\",\n        },\n        startTime,\n      );\n      tl.set({}, {}, 5);\n      window.__timelines = window.__timelines || {};\n      window.__timelines[\"stagger-lattice-demo\"] = tl;\n    </script>\n  </body>\n</html>\n"}