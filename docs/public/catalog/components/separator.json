-space-12, 48px);\n    --_hf-ui-space-16: var(--sc-ui-space-16, 64px);\n    --_hf-ui-space-2: var(--sc-ui-space-2, 8px);\n    --_hf-ui-space-3: var(--sc-ui-space-3, 12px);\n    --_hf-ui-space-4: var(--sc-ui-space-4, 16px);\n    --_hf-ui-space-6: var(--sc-ui-space-6, 24px);\n    --_hf-ui-space-8: var(--sc-ui-space-8, 32px);\n    --_hf-ui-surface: var(--sc-ui-surface, #141414);\n    --_hf-ui-surface-inset: var(--sc-ui-surface-inset, #101010);\n    --_hf-ui-surface-raised: var(--sc-ui-surface-raised, #1a1a1a);\n    --_hf-ui-text: var(--sc-ui-text, #e5e5e5);\n    --_hf-ui-text-faint: var(--sc-ui-text-faint, #7e7e7e);\n    --_hf-ui-text-muted: var(--sc-ui-text-muted, #929292);\n    --_hf-ui-text-strong: var(--sc-ui-text-strong, #f3f3f3);\n    --_hf-ui-warning: var(--sc-ui-warning, #e9ab55);\n    --_hf-ui-weight-medium: var(--sc-ui-weight-medium, 500);\n    --_hf-ui-weight-regular: var(--sc-ui-weight-regular, 400);\n    --_hf-ui-weight-semibold: var(--sc-ui-weight-semibold, 600);\n    box-sizing: border-box;\n    color-scheme: dark;\n    font-family: var(--_hf-ui-font-sans);\n  }\n  /* prettier-ignore */\n  [data-sc-ui-root] *,\n  [data-sc-ui-root] *::before,\n  [data-sc-ui-root] *::after {\n    box-sizing: border-box;\n  }\n  /* prettier-ignore */\n  [data-sc-theme=\"light\"] [data-sc-ui-root],\n  [data-sc-ui-root][data-sc-theme=\"light\"] {\n    --_hf-ui-accent: var(--sc-ui-accent, #087a57);\n    --_hf-ui-action: var(--sc-ui-action, #171717);\n    --_hf-ui-action-contrast: var(--sc-ui-action-contrast, #ffffff);\n    --_hf-ui-border: var(--sc-ui-border, #e0dfdb);\n    --_hf-ui-border-strong: var(--sc-ui-border-strong, #cbc9c3);\n    --_hf-ui-canvas: var(--sc-ui-canvas, #f6f5f1);\n    --_hf-ui-control-border: var(--sc-ui-control-border, #888888);\n    --_hf-ui-control-border-hover: var(--sc-ui-control-border-hover, #6f6e68);\n    --_hf-ui-danger: var(--sc-ui-danger, #a61b1b);\n    --_hf-ui-data-1: var(--sc-ui-data-1, #087a57);\n    --_hf-ui-data-2: var(--sc-ui-data-2, #24