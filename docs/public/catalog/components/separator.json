ed-motion: reduce) {\n    [data-sc-ui-root],\n    [data-sc-ui-root] *,\n    [data-sc-ui-root] *::before,\n    [data-sc-ui-root] *::after {\n      animation-duration: 0s !important;\n      animation-delay: 0s !important;\n      transition-duration: 0s !important;\n      transition-delay: 0s !important;\n      scroll-behavior: auto !important;\n    }\n  }\n  /* sc-ui:tokens:end */\n  .sc-ui-separator {\n    --sc-separator-progress: 1;\n    width: min(360px, 100%);\n    height: 1px;\n    background: var(--_hf-ui-border);\n    overflow: hidden;\n  }\n  .sc-ui-separator span {\n    display: block;\n    width: calc(var(--sc-separator-progress) * 100%);\n    height: 100%;\n    background: var(--_hf-ui-control-border);\n    transform-origin: left center;\n  }\n  .sc-ui-separator[data-orientation=\"vertical\"] {\n    width: 1px;\n    height: 180px;\n  }\n</style>\n\n<!--\n  Timeline integration:\n  tl.fromTo('.sc-ui-separator', { '--sc-separator-progress': 0 }, { '--sc-separator-progress': 1, duration: 0.42, ease: 'power3.out' }, startTime);\n-->\n<!-- sc-ui:canonical:end -->\n      </section>\n      <p class=\"sc-ui-demo-caption\">Separator</p>\n      <script>\n  (function () {\n    \"use strict\";\n\n    var vars =\n      window.__smashcut && window.__smashcut.getVariables\n        ? window.__smashcut.getVariables()\n        : {};\n\n    // Unrecognised overrides return to their declared defaults.\n    var orientations = { horizontal: true, vertical: true };\n    var thicknesses = { hairline: \"1px\", medium: \"2px\", bold: \"4px\" };\n    var tones = {\n      neutral: \"var(--_hf-ui-control-border)\",\n      accent: \"var(--_hf-ui-accent)\",\n      warning: \"var(--_hf-ui-warning)\",\n    };\n\n    function pick(table, value, fallback) {\n      return Object.prototype.hasOwnProperty.call(table, value) ? value : fallback;\n    }\n\n    var orientation = pick(orientations, vars.orientation, \"horizontal\");\n    var thickness = thicknesses[pick(thicknesses, vars.thickness, \"hairline\")];\n    var tone = tones[pick(tones, vars.tone, \"neutral\")];\n\n    var roots = document.querySelectorAll(\".sc-ui-separator\");\n    for (var i = 0; i < roots.length; i += 1) {\n      roots[i].setAttribute(\"data-orientation\", orientation);\n      roots[i].setAttribute(\"aria-orientation\", orientation);\n      roots[i].style.setProperty(\"--sc-separator-thickness\", thickness);\n      roots[i].style.setProperty(\"--sc-separator-fill\", tone);\n    }\n  })();\n</script>\n<script>\n        const tl = gsap.timeline({ paused: true });\n        tl.addLabel(\"start\", 0);\n        tl.set(\".sc-ui-demo-stage\", { opacity: 1 }, 0);\n        tl.set(\".sc-ui-separator\", { \"--sc-separator-progress\": 0, immediateRender: true }, 0);\n        tl.to(\n          \".sc-ui-separator\",\n          { \"--sc-separator-progress\": 1, duration: 0.42, ease: \"power3.out\" },\n          0.6,\n        );\n        tl.addLabel(\"end\", 3.99);\n        tl.to(\".sc-ui-demo-stage\", { opacity: 1, duration: 0.01 }, 3.99);\n        window.__timelines = window.__timelines || {};\n        window.__timelines[\"separator-demo\"] = tl;\n      </script>\n    </main>\n  <style>\n  /* sc-ui:tokens:start */\n  /* prettier-ignore */\n  [data-sc-ui-root] {\n    --_hf-ui-accent: var(--sc-ui-accent, #3ce6ac);\n    --_hf-ui-action: var(--sc-ui-action, #eeeeee);\n    --_hf-ui-action-contrast: var(--sc-ui-action-contrast, #111111);\n    --_hf-ui-border: var(--sc-ui-border, #2a2a2a);\n    --_hf-ui-border-strong: var(--sc-ui-border-strong, #383838);\n    --_hf-ui-canvas: var(--sc-ui-canvas, #0a0a0a);\n    --_hf-ui-control-border: var(--sc-ui-control-border, #686868);\n    --_hf-ui-control-border-hover: var(--sc-ui-control-border-hover, #777777);\n    --_hf-ui-control-height: var(--sc-ui-control-height, 40px);\n    --_hf-ui-danger: var(--sc-ui-danger, #ff7878);\n    --_hf-ui-data-1: var(--sc-ui-data-1, #3ce6ac);\n    --_hf-ui-data-2: var(--sc-ui-data-2, #63a5ff);\n    --_hf-ui-data-3: var(--sc-ui