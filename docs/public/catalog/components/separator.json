{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <title>Separator — Operator Black</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n      }\n      body {\n        background: #0a0a0a;\n      }\n      .sc-ui-demo-canvas {\n        width: 1920px;\n        height: 1080px;\n        box-sizing: border-box;\n        display: grid;\n        grid-template-rows: 1fr auto;\n        place-items: center;\n        padding: 96px;\n        background: #0a0a0a;\n        color: #e5e5e5;\n        font-family:\n          ui-sans-serif,\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          sans-serif;\n      }\n      .sc-ui-demo-stage {\n        display: grid;\n        place-items: center;\n        width: min(720px, 100%);\n        min-width: 0;\n        max-width: 100%;\n      }\n      .sc-ui-demo-caption {\n        justify-self: start;\n        color: #929292;\n        font:\n          500 18px/1.4 ui-monospace,\n          \"SFMono-Regular\",\n          Menlo,\n          Consolas,\n          monospace;\n        letter-spacing: 0.01em;\n      }\n    </style>\n  </head>\n  <body>\n    <main\n      class=\"sc-ui-demo-canvas\"\n      data-composition-id=\"separator-demo\"\n      data-start=\"0\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n      data-duration=\"4\"\n      data-sc-rendering=\"true\"\n      data-sc-theme=\"dark\"\n    >\n      <!-- prettier-ignore -->\n      <section class=\"sc-ui-demo-stage\" aria-label=\"Separator specimen\" inert>\n        <!-- sc-ui:canonical:start -->\n<!--\n  Separator - Operator Black structural rule primitive for SmashCut.\n\n  Paste the markup and CSS into a composition. Animate the CSS variables\n  from a p